# Copy to functions/.env and fill in after the Meta setup is done.
# The access token is NOT stored here - it is a secret:
#   firebase functions:secrets:set WHATSAPP_TOKEN

# From Meta App Dashboard > WhatsApp > API Setup ("Phone number ID")
WHATSAPP_PHONE_NUMBER_ID=

# Name of the approved message template (Business Manager > WhatsApp Manager > Message templates)
WHATSAPP_TEMPLATE_NAME=task_assigned

# Language code the template was approved in
WHATSAPP_TEMPLATE_LANG=en

# Optional: Graph API version override
# WHATSAPP_API_VERSION=v22.0
